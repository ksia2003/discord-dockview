%!PS-Adobe-3.0 EPSF-3.0
%%Creator: DockView sample
%%Title: example.eps
%%BoundingBox: 0 0 320 180
%%EndComments
% rounded indigo panel
0.31 0.275 0.898 setrgbcolor
20 20 280 140 rectfill
% white title text
1 1 1 setrgbcolor
/Helvetica-Bold findfont 30 scalefont setfont
70 110 moveto (DockView) show
/Helvetica findfont 16 scalefont setfont
90 80 moveto (EPS vector sample) show
% a small circle mark
1 0.6 0.1 setrgbcolor
260 130 14 0 360 arc fill
showpage
%%EOF
